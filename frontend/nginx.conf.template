# Rendered by the nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf at container start.
#
# The server-side API key and backend upstream are environment-backed tokens
# used below. The stock entrypoint substitutes defined environment variables and
# preserves native nginx variables such as $remote_addr, $proxy_host, and $uri
# (these lowercase names are not expected to exist as environment variables).
# The backend API key is injected here, server-side, and never reaches the
# browser.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Owner access gate. Protects the SPA and the /api/ proxy below.
    auth_basic "AI DevOps Demo (owner access)";
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    # Same-origin API proxy. The backend requires X-API-Key; it is added here.
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        # Explicit upload ceiling. The application caps the whole document
        # request at DOCUMENT_MAX_SIZE_BYTES + DOCUMENT_MULTIPART_OVERHEAD_BYTES
        # (default 1,048,576 + 65,536 = 1,114,112 bytes). This 2 MiB proxy limit
        # sits above that cap so framing overhead is not rejected at the edge;
        # the backend still enforces the exact file limit. If either setting is
        # raised, keep this value above their sum.
        client_max_body_size 2m;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        # Overwrite (never append) client-supplied forwarding headers so a
        # client cannot spoof its identity. The backend trusts this peer only
        # because it is listed in TRUSTED_PROXY_IPS.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-API-Key ${API_KEY};
        # Do not forward the owner Basic Auth credential to the backend.
        proxy_set_header Authorization "";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
