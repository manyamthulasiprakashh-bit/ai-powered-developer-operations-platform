# Application
APP_ENV=development
APP_NAME=ai-devops-platform
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
PORT=8000
# PostgreSQL is required for analysis history/statistics, document persistence,
# and database-aware readiness. Run `alembic upgrade head` before starting the
# API against a new database.
DATABASE_URL=postgresql://postgres:dev-only-password@db:5432/devops_platform
POSTGRES_PASSWORD=dev-only-password
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_CONNECT_TIMEOUT=5
GITHUB_READ_TIMEOUT=15
GITHUB_MAX_CONNECTIONS=100
GITHUB_MAX_KEEPALIVE_CONNECTIONS=20
GITHUB_MAX_PER_PAGE=100
# Reserved for future LLM extraction (M4). The current deterministic workflow
# does not use these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Example origins only; replace the deployment origin with your verified host.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-deployed-frontend.example.com
# Server-side API key required in the X-API-Key header for analysis creation,
# analysis history/statistics, document intake, and deterministic extraction.
# When unset, those endpoints fail closed (deny). In the public-demo Compose
# stack the frontend Nginx container also consumes this value to inject the
# header on /api/ proxy requests, but it is never placed in frontend assets.
# Set a long random value from the platform secret store; never commit a real
# key. Generate one with `openssl rand -hex 32` (64 hex characters). The
# frontend Nginx entrypoint accepts only [A-Za-z0-9_-] with a length of 16-128
# characters because the value is injected into its config. Do not use the
# placeholder value in production.
API_KEY=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_ANALYSIS_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated proxy IPs allowed to set X-Forwarded-For. Leave empty unless a
# known reverse proxy fronts the API; X-Forwarded-For is ignored otherwise.
TRUSTED_PROXY_IPS=
# Document intake and deterministic extraction (M0-M3). Uploads are validated
# against these limits; the file size is enforced while reading and the whole
# multipart request is capped at DOCUMENT_MAX_SIZE_BYTES +
# DOCUMENT_MULTIPART_OVERHEAD_BYTES before parsing. Extraction is local and
# deterministic; no LLM/OpenAI provider is implemented yet (M4).
# Bounds: size 1..16777216, text 1..200000, preview 1..2000, overhead 0..1048576.
DOCUMENT_MAX_SIZE_BYTES=1048576
DOCUMENT_MAX_TEXT_CHARS=20000
DOCUMENT_PREVIEW_CHARS=500
DOCUMENT_MULTIPART_OVERHEAD_BYTES=65536
DOCUMENT_ALLOWED_CONTENT_TYPES=text/plain,text/markdown
DOCUMENT_ALLOWED_EXTENSIONS=.txt,.md
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500
GITHUB_MAX_RETRIES=2
GITHUB_RETRY_BASE_DELAY_SECONDS=0.25
GITHUB_RETRY_MAX_DELAY_SECONDS=2
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=1

# Frontend
# The same-origin Compose demo serves the SPA and proxies /api through Nginx, so
# the SPA uses a relative base. Use `/` (the same-origin sentinel) for that
# deployment. For split hosting (frontend and backend on different origins),
# set this to the exact absolute public HTTPS backend origin instead; Vite bakes
# the value into browser assets, so never place a secret here. Vite-only local
# development cannot call protected endpoints because it does not send
# X-API-Key and has no development proxy; use the Compose/Nginx workflow.
VITE_API_BASE_URL=/

# Public-demo Compose networking. The frontend proxy is assigned this fixed
# address and the backend trusts forwarded headers only from it. Keep these
# consistent if you change EDGE_SUBNET.
FRONTEND_PROXY_IP=172.28.0.10
EDGE_SUBNET=172.28.0.0/24

# Basic Auth owner credential for the public demo is supplied as a file, not an
# environment variable:
#   mkdir -p secrets
#   openssl passwd -apr1 'your-owner-password' > secrets/htpasswd   # or use htpasswd
# The file is mounted read-only into the frontend container and is gitignored.
# Never commit it. Serve the demo over HTTPS only.
