# Application
APP_ENV=development
APP_NAME=ai-devops-platform
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql://postgres:dev-only-password@db:5432/devops_platform
POSTGRES_PASSWORD=dev-only-password
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_CONNECT_TIMEOUT=5
GITHUB_READ_TIMEOUT=15
GITHUB_MAX_CONNECTIONS=100
GITHUB_MAX_KEEPALIVE_CONNECTIONS=20
GITHUB_MAX_PER_PAGE=100
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-deployed-frontend.example.com
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500

# Frontend
# Set this to the deployed backend origin in production.
VITE_API_BASE_URL=http://localhost:8000
